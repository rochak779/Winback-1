# Server-only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional — defaults to gemini-flash-latest (Google's stable alias; verified
# live against this project's key on 2026-09-05 — gemini-2.5-* has aged out)
GEMINI_MODEL=

# Optional — defaults to gemini-pro-latest
GEMINI_MODEL_REASONING=

# The GCP project id
GOOGLE_CLOUD_PROJECT=

# Whole service-account JSON, single line. Server-only.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional — defaults to (default)
FIRESTORE_DATABASE_ID=

# Public by design, not a secret — identifies the project to the client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Optional — defaults to winback_session
SESSION_COOKIE_NAME=

# Optional — defaults to 500
RUN_BUDGET_MAX=

# Local only. 1 to mock Gemini calls. Throws if set in production.
MOCK_LLM=

# Optional — defaults to WinBack
NEXT_PUBLIC_APP_NAME=
